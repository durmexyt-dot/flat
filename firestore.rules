rules_version = '2';

// Stubswap security rules.
//
// Payments run in TEST MODE (payment simulator) until a server takes over:
// the app then creates orders and records the simulated payment itself.
// These rules keep that honest: an order can only be paid together with
// taking its tickets off the listing and creating the seller's payout, in
// one transaction, with amounts that match the listing.
// With real Stripe, a Cloud Function (Admin SDK, bypasses these rules)
// writes orders and payouts, and the test-mode rules below can go.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function orderPath(id) { return /databases/$(database)/documents/orders/$(id); }
    function listingPath(id) { return /databases/$(database)/documents/listings/$(id); }
    function payoutPath(id) { return /databases/$(database)/documents/payouts/$(id); }
    function eventPath(id) { return /databases/$(database)/documents/events/$(id); }
    function rolePath(uid) { return /databases/$(database)/documents/roles/$(uid); }
    function feesPath() { return /databases/$(database)/documents/config/fees; }
    function resalePath() { return /databases/$(database)/documents/config/resale; }
    function limitsPath() { return /databases/$(database)/documents/config/limits; }
    function statsPath(uid) { return /databases/$(database)/documents/sellerStats/$(uid); }
    function banPath(uid) { return /databases/$(database)/documents/bans/$(uid); }

    // ---- Roles ------------------------------------------------------------
    // Admins exist only through the Firebase console (roles/{uid} with
    // role "admin"); no client can write that. Admins name support accounts.
    // One get() per document (an extra exists() would count against the
    // rules' limit of 10 document reads per request).
    function docData(path) {
      let d = get(path);
      return d == null ? {} : d.data;
    }
    function role() {
      return signedIn() ? docData(rolePath(request.auth.uid)).get('role', '') : '';
    }
    function isAdmin() { return role() == 'admin'; }
    function isStaff() { return role() in ['admin', 'support']; }

    // Fees for new listings; 10 % each until an admin sets them.
    function currentFees() {
      let fees = docData(feesPath());
      return {'buyerPercent': fees.get('buyerPercent', 10),
        'sellerPercent': fees.get('sellerPercent', 10)};
    }
    function validPercent(v) { return v is int && v >= 0 && v <= 30; }

    // ---- Moderation, resale rules, seller limits ------------------------------
    // The team (admins and support) blocks accounts: blocked users can't sell,
    // buy or add events (Cloud Function writes bans/{uid}).
    function banned() { return exists(banPath(request.auth.uid)); }

    // Resale rules (admins): the highest price as percent above the face
    // value, for all events or one event; null means no limit. With a limit
    // (or when required) the face value must be given.
    function resaleConfig() {
      return docData(resalePath());
    }
    function markupLimit(eventId) {
      let e = docData(eventPath(eventId));
      return e.get('maxMarkupPercent', null) != null
        ? e.maxMarkupPercent
        : resaleConfig().get('maxMarkupPercent', null);
    }
    function withinResaleRules(d) {
      let limit = markupLimit(d.get('eventId', ''));
      let needsFace = limit != null || resaleConfig().get('requireFaceValue', false) == true;
      return (!needsFace || d.get('faceValueMinor', null) != null)
        && (limit == null || d.priceMinor * 100 <= d.faceValueMinor * (100 + limit));
    }
    function validMarkup(v) { return v == null || (v is int && v >= 0 && v <= 1000); }

    // New sellers list a few tickets at first; after some completed sales
    // (or when the team trusts them) there is no limit. Counts come from the
    // Cloud Function (sellerStats/{uid}).
    function limitsConfig() {
      return docData(limitsPath());
    }
    function sellerStats() {
      return docData(statsPath(request.auth.uid));
    }
    function withinSellerLimits(d) {
      let s = sellerStats();
      let c = limitsConfig();
      return s.get('trusted', false) == true
        || s.get('completedSales', 0) >= c.get('trustedAfterSales', 3)
        || (d.quantity <= c.get('newSellerMaxTickets', 6)
          && s.get('activeListings', 0) < c.get('newSellerMaxListings', 5));
    }

    // ---- Reservations -------------------------------------------------------
    // Opening an order holds its tickets for 15 minutes (quantityReserved on
    // the listing). Paying or a failed payment releases them; the Cloud
    // Function releases expired holds.
    function reserved(d) { return d.get('quantityReserved', 0); }
    function released(before, q) { return before >= q ? before - q : 0; }
    function isReserved(o) { return o.get('reserved', false) == true; }

    // True if order [id] goes from awaiting payment to paid in this very
    // request (get() reads the state before, getAfter() after it).
    function paidNow(id) {
      let before = get(orderPath(id)).data;
      let after = getAfter(orderPath(id)).data;
      return before.status == 'pendingPayment'
        && after.status == 'paid'
        && after.testMode == true
        && after.buyerId == request.auth.uid;
    }

    // True if the seller cancels order [id] in this very request: from paid
    // or tickets sent to refunded.
    function sellerCancelsNow(id) {
      let before = get(orderPath(id)).data;
      let after = getAfter(orderPath(id)).data;
      return (before.status == 'paid' || before.status == 'ticketsSent')
        && after.status == 'refunded'
        && after.cancelledBy == 'seller'
        && after.testMode == true
        && after.sellerId == request.auth.uid;
    }

    // ---- Validation helpers ---------------------------------------------
    // Everything not explicitly allowed below is denied. Writes must keep to
    // known fields, types and sizes, so nobody can store junk, oversized
    // data or fields the app would trust (e.g. "verified").

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function optStr(d, key, max) {
      return !(key in d) || d[key] == null || str(d[key], 0, max);
    }
    function verifiedEmail() {
      return request.auth.token.email_verified == true;
    }
    function usernamePath(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    // A username in a profile must be reserved by this user.
    function ownsUsername(d) {
      return !('username' in d) || d.username == null
        || (d.username is string
          && getAfter(usernamePath(d.username)).data.uid == request.auth.uid);
    }
    function validVisibility(d) {
      return !('visibility' in d) || d.visibility in ['public', 'private'];
    }
    // Profile photo: a small inline JPEG (256 px), well under 200 KB.
    function validPhoto(d) {
      return !('photo' in d) || d.photo == null || str(d.photo, 1, 200000);
    }
    function validEvent(e) {
      return e is map
        && e.keys().hasOnly(['name', 'venue', 'city', 'date', 'category'])
        && str(e.name, 2, 100)
        && str(e.venue, 1, 100)
        && str(e.city, 1, 60)
        && e.date is timestamp
        && e.date > request.time
        && e.date < request.time + duration.value(730, 'd')
        && e.category in ['concerts', 'sports', 'theater', 'festivals', 'other'];
    }
    // Ticket price per piece: 0.01 to 10 000.00 in the listing's currency.
    function validPrice(p) {
      return p is int && p > 0 && p <= 1000000;
    }

    // Seller's share: ticket price minus the order's seller fee (10 % for
    // orders from before fees were configurable).
    function sellerEarnings(o) {
      return o.unitPriceMinor * o.quantity
        - math.round(o.unitPriceMinor * o.quantity
          * o.get('sellerFeePercent', 10) / 100);
    }

    // Private profile: settings, notification preferences.
    match /users/{uid} {
      function validUser(d) {
        return d.keys().hasOnly(['displayName', 'email', 'username', 'photo',
            'visibility', 'notifications', 'createdAt', 'updatedAt',
            'termsAcceptedAt', 'termsVersion', 'language'])
          // The app's language, for emails.
          && (!('language' in d) || d.language in ['bs', 'de', 'en'])
          // When the user accepted the terms (signup), and which version.
          && (!('termsAcceptedAt' in d) || d.termsAcceptedAt is timestamp)
          && optStr(d, 'termsVersion', 20)
          && optStr(d, 'displayName', 80)
          // The sign-in's own email, nothing made up.
          && (!('email' in d) || d.email == null
            || d.email == request.auth.token.email)
          && validPhoto(d)
          && validVisibility(d)
          && (!('notifications' in d) || (d.notifications is map
            && d.notifications.keys().hasOnly(['orderUpdates', 'saleUpdates',
              'payoutUpdates', 'priceAlerts', 'eventReminders', 'newsletter',
              'email', 'push'])))
          && ownsUsername(d);
      }

      // The team finds single users by email or username (support accounts,
      // moderation).
      allow read: if isUser(uid) || isStaff();
      allow create: if isUser(uid) && validUser(request.resource.data);
      allow update: if isUser(uid) && validUser(request.resource.data)
        // A changed username frees the old reservation in the same write.
        && (resource.data.get('username', null) == null
          || resource.data.username == request.resource.data.get('username', null)
          || !existsAfter(usernamePath(resource.data.username)));
      allow delete: if isUser(uid);

      // Only the payout method, with a well-formed IBAN.
      match /private/{doc} {
        allow read, delete: if isUser(uid);
        allow write: if isUser(uid)
          && doc == 'payoutMethod'
          && request.resource.data.keys().hasOnly(['accountHolder', 'iban', 'updatedAt'])
          && str(request.resource.data.accountHolder, 2, 100)
          && request.resource.data.iban.matches('^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$');
      }
    }

    // What other users may see: name, username, photo.
    match /publicProfiles/{uid} {
      allow read: if isUser(uid) || resource.data.visibility == 'public';
      allow write: if isUser(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'username', 'photo', 'visibility'])
        && optStr(request.resource.data, 'displayName', 80)
        && validPhoto(request.resource.data)
        && validVisibility(request.resource.data)
        && ownsUsername(request.resource.data);
      allow delete: if isUser(uid);
    }

    // Username reservations, one document per lowercase username. A user
    // holds one at a time: the profile must point to it.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_.]{3,20}$')
        && getAfter(userPath(request.auth.uid)).data.get('username', null) == name;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(userPath(request.auth.uid))
          || getAfter(userPath(request.auth.uid)).data.get('username', null) != name);
    }

    match /listings/{id} {
      allow read: if resource.data.status == 'active'
        || isUser(resource.data.sellerId) || isStaff();
      allow create: if signedIn()
        // Only sellers with a confirmed email address list tickets.
        && verifiedEmail()
        // Team accounts (admins, support) don't sell; blocked users neither.
        && !isStaff()
        && !banned()
        && withinSellerLimits(request.resource.data)
        && withinResaleRules(request.resource.data)
        && request.resource.data.sellerId == request.auth.uid
        // Sellers need a payout method before listing tickets.
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/payoutMethod)
        && request.resource.data.keys().hasOnly(['sellerId', 'eventId', 'event',
            'buyerFeePercent', 'sellerFeePercent', 'faceValueMinor', 'ticketType',
            'quantity', 'quantitySold', 'quantityReserved', 'priceMinor', 'currency', 'status',
            'section', 'row', 'seats', 'note', 'createdAt', 'updatedAt'])
        && validEvent(request.resource.data.event)
        // Tickets only for a visible event an admin created; the copy of
        // the event is exactly the event.
        && request.resource.data.eventId is string
        && get(eventPath(request.resource.data.eventId)).data.status
          in ['pending', 'confirmed', 'active']
        && request.resource.data.event == {
          'name': get(eventPath(request.resource.data.eventId)).data.name,
          'venue': get(eventPath(request.resource.data.eventId)).data.venue,
          'city': get(eventPath(request.resource.data.eventId)).data.city,
          'date': get(eventPath(request.resource.data.eventId)).data.date,
          'category': get(eventPath(request.resource.data.eventId)).data.category
        }
        // The fees in force now stay with the listing.
        && request.resource.data.buyerFeePercent == currentFees().buyerPercent
        && request.resource.data.sellerFeePercent == currentFees().sellerPercent
        && request.resource.data.ticketType in ['eTicket', 'mobile', 'paper']
        && request.resource.data.status == 'active'
        && request.resource.data.quantitySold == 0
        && reserved(request.resource.data) == 0
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 50
        && validPrice(request.resource.data.priceMinor)
        // The original price on the ticket, if given.
        && (!('faceValueMinor' in request.resource.data)
          || validPrice(request.resource.data.faceValueMinor))
        && request.resource.data.currency in ['BAM', 'EUR', 'USD']
        && optStr(request.resource.data, 'section', 40)
        && optStr(request.resource.data, 'row', 40)
        && optStr(request.resource.data, 'seats', 60)
        && optStr(request.resource.data, 'note', 300)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if
        // Sellers may change the price or withdraw while the listing is active.
        (isUser(resource.data.sellerId)
          && resource.data.status == 'active'
          && (
            (onlyChanges(['priceMinor', 'faceValueMinor', 'updatedAt'])
              && validPrice(request.resource.data.priceMinor)
              && (request.resource.data.get('faceValueMinor', null) == null
                || validPrice(request.resource.data.faceValueMinor))
              && withinResaleRules(request.resource.data))
            || (onlyChanges(['status', 'updatedAt'])
              && request.resource.data.status == 'withdrawn')
          ))
        // Test mode: the seller cancels a sale, its tickets go back on sale
        // and a sold-out listing reopens.
        || (isUser(resource.data.sellerId)
          && onlyChanges(['quantitySold', 'status', 'lastOrderId', 'updatedAt'])
          && sellerCancelsNow(request.resource.data.lastOrderId)
          && getAfter(orderPath(request.resource.data.lastOrderId)).data.listingId == id
          && request.resource.data.quantitySold == resource.data.quantitySold
            - getAfter(orderPath(request.resource.data.lastOrderId)).data.quantity
          && (
            (resource.data.status == 'soldOut' && request.resource.data.status == 'active')
            || (resource.data.status != 'soldOut'
              && request.resource.data.status == resource.data.status)
          ))
        // Test mode: a buyer's payment takes the tickets off the listing and
        // ends their reservation.
        || (signedIn()
          && onlyChanges(['quantitySold', 'quantityReserved', 'status', 'lastOrderId', 'updatedAt'])
          && paidNow(request.resource.data.lastOrderId)
          && reserved(request.resource.data)
            == (isReserved(getAfter(orderPath(request.resource.data.lastOrderId)).data)
              ? released(reserved(resource.data),
                  getAfter(orderPath(request.resource.data.lastOrderId)).data.quantity)
              : reserved(resource.data))
          && getAfter(orderPath(request.resource.data.lastOrderId)).data.listingId == id
          && request.resource.data.quantitySold == resource.data.quantitySold
            + getAfter(orderPath(request.resource.data.lastOrderId)).data.quantity
          && (
            (request.resource.data.quantitySold == resource.data.quantity
              && request.resource.data.status == 'soldOut')
            || (request.resource.data.quantitySold < resource.data.quantity
              && request.resource.data.status == resource.data.status)
          ))
        // A buyer opens an order: its tickets are held while they pay.
        || (signedIn()
          && resource.data.status == 'active'
          && onlyChanges(['quantityReserved', 'lastOrderId', 'updatedAt'])
          && !exists(orderPath(request.resource.data.lastOrderId))
          && getAfter(orderPath(request.resource.data.lastOrderId)).data.buyerId == request.auth.uid
          && getAfter(orderPath(request.resource.data.lastOrderId)).data.listingId == id
          && getAfter(orderPath(request.resource.data.lastOrderId)).data.status == 'pendingPayment'
          && reserved(request.resource.data) == reserved(resource.data)
            + getAfter(orderPath(request.resource.data.lastOrderId)).data.quantity
          && reserved(request.resource.data) + resource.data.quantitySold
            <= resource.data.quantity)
        // The payment failed: the held tickets are free again.
        || (signedIn()
          && onlyChanges(['quantityReserved', 'lastOrderId', 'updatedAt'])
          && get(orderPath(request.resource.data.lastOrderId)).data.status == 'pendingPayment'
          && getAfter(orderPath(request.resource.data.lastOrderId)).data.status == 'cancelled'
          && getAfter(orderPath(request.resource.data.lastOrderId)).data.buyerId == request.auth.uid
          && getAfter(orderPath(request.resource.data.lastOrderId)).data.listingId == id
          && isReserved(getAfter(orderPath(request.resource.data.lastOrderId)).data)
          && reserved(request.resource.data) == released(reserved(resource.data),
            getAfter(orderPath(request.resource.data.lastOrderId)).data.quantity));
    }

    // Ticket files a seller uploaded for a listing (the files themselves are
    // in Storage). Only the seller sees them; buyers get their copies under
    // orders/{id}/files from the Cloud Function.
    match /listings/{id}/files/{fileId} {
      allow read: if signedIn() && get(listingPath(id)).data.sellerId == request.auth.uid;
      allow create: if signedIn()
        && get(listingPath(id)).data.sellerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'contentType', 'size',
            'storagePath', 'tickets', 'orderId', 'checked', 'uploadedAt'])
        // The Cloud Function checks every file for copies before delivery.
        && request.resource.data.checked == false
        && str(request.resource.data.name, 1, 120)
        && request.resource.data.contentType
          in ['application/pdf', 'image/png', 'image/jpeg', 'image/webp']
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size < 10485760
        && request.resource.data.storagePath
          == 'tickets/' + request.auth.uid + '/' + id + '/' + fileId
        && request.resource.data.tickets is int
        && request.resource.data.tickets >= 1
        && request.resource.data.tickets <= 50
        && request.resource.data.orderId == null
        && request.resource.data.uploadedAt == request.time;
      // Not yet handed to a buyer.
      allow delete: if signedIn()
        && get(listingPath(id)).data.sellerId == request.auth.uid
        && resource.data.orderId == null;
    }

    // The tickets an order received (written by the Cloud Function).
    match /orders/{id}/files/{fileId} {
      allow read: if signedIn()
        && (get(orderPath(id)).data.buyerId == request.auth.uid
          || get(orderPath(id)).data.sellerId == request.auth.uid
          || isStaff());
    }

    match /orders/{id} {
      // The team reads orders to handle reported problems.
      allow read: if isUser(resource.data.buyerId) || isUser(resource.data.sellerId)
        || isStaff();

      // Test mode: the buyer opens an order at the listing's current price.
      allow create: if signedIn()
        // Team accounts (admins, support) don't buy; blocked users neither.
        && !isStaff()
        && !banned()
        && request.resource.data.testMode == true
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'pendingPayment'
        && request.resource.data.keys().hasOnly(['number', 'listingId', 'buyerId',
            'sellerId', 'event', 'quantity', 'unitPriceMinor', 'currency',
            'buyerFeePercent', 'sellerFeePercent',
            'ticketType', 'section', 'row', 'seats', 'status', 'history',
            'testMode', 'reserved', 'createdAt'])
        // The listing's fees, 10 % for listings from before fees were set.
        && request.resource.data.get('buyerFeePercent', 10)
          == get(listingPath(request.resource.data.listingId)).data.get('buyerFeePercent', 10)
        && request.resource.data.get('sellerFeePercent', 10)
          == get(listingPath(request.resource.data.listingId)).data.get('sellerFeePercent', 10)
        && request.resource.data.number.matches('^SSW-[A-Z0-9]{6}$')
        && request.resource.data.history is list
        && request.resource.data.history.size() == 1
        // The reservation runs from the server's time.
        && request.resource.data.createdAt == request.time
        // The tickets are held in the same write (see listings).
        && request.resource.data.reserved == true
        && getAfter(listingPath(request.resource.data.listingId)).data.lastOrderId == id
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 10
        && request.resource.data.sellerId != request.auth.uid
        // The ticket details are the listing's, not made up by the buyer.
        && request.resource.data.event
          == get(listingPath(request.resource.data.listingId)).data.event
        && request.resource.data.ticketType
          == get(listingPath(request.resource.data.listingId)).data.ticketType
        && request.resource.data.section
          == get(listingPath(request.resource.data.listingId)).data.get('section', '')
        && request.resource.data.row
          == get(listingPath(request.resource.data.listingId)).data.get('row', '')
        && request.resource.data.seats
          == get(listingPath(request.resource.data.listingId)).data.get('seats', '')
        && get(listingPath(request.resource.data.listingId)).data.status == 'active'
        && request.resource.data.sellerId
          == get(listingPath(request.resource.data.listingId)).data.sellerId
        && request.resource.data.unitPriceMinor
          == get(listingPath(request.resource.data.listingId)).data.priceMinor
        && request.resource.data.currency
          == get(listingPath(request.resource.data.listingId)).data.currency
        && request.resource.data.quantity
          <= get(listingPath(request.resource.data.listingId)).data.quantity
            - get(listingPath(request.resource.data.listingId)).data.quantitySold
            - reserved(get(listingPath(request.resource.data.listingId)).data);

      allow update: if resource.data.testMode == true && (
        // Buyer: the simulated payment failed.
        (isUser(resource.data.buyerId)
          && resource.data.status == 'pendingPayment'
          && request.resource.data.status == 'cancelled'
          && onlyChanges(['status', 'history', 'failureReason', 'updatedAt'])
          // Held tickets are released in the same write.
          && (!isReserved(resource.data)
            || reserved(getAfter(listingPath(resource.data.listingId)).data)
              == released(reserved(get(listingPath(resource.data.listingId)).data),
                resource.data.quantity)))
        // Buyer: paid, only together with the listing and the payout.
        || (isUser(resource.data.buyerId)
          && resource.data.status == 'pendingPayment'
          && request.resource.data.status == 'paid'
          && onlyChanges(['status', 'history', 'paymentId', 'paymentMethod', 'updatedAt'])
          // Only while the tickets are held for this buyer.
          && (!isReserved(resource.data)
            || request.time < resource.data.createdAt + duration.value(15, 'm'))
          && getAfter(listingPath(resource.data.listingId)).data.lastOrderId == id
          && existsAfter(payoutPath(id)))
        // Seller: mobile or paper tickets handed over outside the app (e-tickets
        // are delivered by uploading them).
        || (isUser(resource.data.sellerId)
          && resource.data.status == 'paid'
          && resource.data.get('ticketType', 'eTicket') != 'eTicket'
          && request.resource.data.status == 'ticketsSent'
          && onlyChanges(['status', 'history', 'updatedAt']))
        // Seller: cancels the sale; only together with returning the tickets
        // and dropping the payout. Buyers can't cancel a paid order.
        || (isUser(resource.data.sellerId)
          && (resource.data.status == 'paid' || resource.data.status == 'ticketsSent')
          && request.resource.data.status == 'refunded'
          && request.resource.data.cancelledBy == 'seller'
          && onlyChanges(['status', 'cancelledBy', 'history', 'updatedAt'])
          && getAfter(listingPath(resource.data.listingId)).data.lastOrderId == id
          // The listing really gets the tickets back (a no-op listing write
          // would otherwise pass as a price change).
          && getAfter(listingPath(resource.data.listingId)).data.quantitySold
            == get(listingPath(resource.data.listingId)).data.quantitySold
              - resource.data.quantity
          && !existsAfter(payoutPath(id)))
      );
    }

    match /payouts/{id} {
      allow read: if isUser(resource.data.sellerId) || isStaff();

      // Test mode: dropped when the seller cancels the sale [id].
      allow delete: if isUser(resource.data.sellerId) && sellerCancelsNow(id);

      // Test mode: created with the payment of order [id], for its seller
      // and exactly the seller's share.
      allow create: if signedIn()
        && request.resource.data.testMode == true
        && request.resource.data.status == 'pending'
        && paidNow(id)
        && request.resource.data.sellerId == getAfter(orderPath(id)).data.sellerId
        && request.resource.data.currency == getAfter(orderPath(id)).data.currency
        && request.resource.data.amountMinor == sellerEarnings(getAfter(orderPath(id)).data);
    }

    // Old requests (before in-app support): only readable by their author.
    match /supportRequests/{id} {
      allow read: if isUser(resource.data.uid);
    }

    // ---- Team, fees, events ---------------------------------------------

    match /roles/{uid} {
      allow read: if isUser(uid) || isAdmin();
      // Admins make and remove support accounts, never admins.
      allow create: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['role', 'name', 'email',
            'grantedBy', 'grantedAt'])
        && request.resource.data.role == 'support'
        && request.resource.data.grantedBy == request.auth.uid
        && optStr(request.resource.data, 'name', 80)
        && optStr(request.resource.data, 'email', 200)
        && request.resource.data.grantedAt == request.time;
      allow delete: if isAdmin() && resource.data.role == 'support';
    }

    match /config/fees {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['buyerPercent', 'sellerPercent',
            'updatedBy', 'updatedAt'])
        && validPercent(request.resource.data.buyerPercent)
        && validPercent(request.resource.data.sellerPercent)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Resale rules: admins only.
    match /config/resale {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['maxMarkupPercent', 'requireFaceValue',
            'updatedBy', 'updatedAt'])
        && validMarkup(request.resource.data.get('maxMarkupPercent', null))
        && request.resource.data.requireFaceValue is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Limits for new sellers: the whole team.
    match /config/limits {
      allow read: if true;
      allow write: if isStaff()
        && request.resource.data.keys().hasOnly(['newSellerMaxListings',
            'newSellerMaxTickets', 'trustedAfterSales', 'updatedBy', 'updatedAt'])
        && request.resource.data.newSellerMaxListings is int
        && request.resource.data.newSellerMaxListings >= 1
        && request.resource.data.newSellerMaxListings <= 100
        && request.resource.data.newSellerMaxTickets is int
        && request.resource.data.newSellerMaxTickets >= 1
        && request.resource.data.newSellerMaxTickets <= 50
        && request.resource.data.trustedAfterSales is int
        && request.resource.data.trustedAfterSales >= 0
        && request.resource.data.trustedAfterSales <= 100
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // The platform's company details on invoices: admins only.
    match /config/company {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'address', 'taxId',
            'vatNumber', 'vatPercent', 'email', 'invoicePrefix', 'updatedBy', 'updatedAt'])
        && str(request.resource.data.name, 1, 120)
        && str(request.resource.data.address, 0, 300)
        && str(request.resource.data.taxId, 0, 40)
        && str(request.resource.data.vatNumber, 0, 40)
        && request.resource.data.vatPercent is int
        && request.resource.data.vatPercent >= 0
        && request.resource.data.vatPercent <= 30
        && str(request.resource.data.email, 0, 120)
        && request.resource.data.invoicePrefix.matches('^[A-Z]{2,6}$')
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Seller counts (Cloud Function), blocks and the team's log.
    match /sellerStats/{uid} {
      allow read: if isUser(uid) || isStaff();
    }
    match /bans/{uid} {
      allow read: if isUser(uid) || isStaff();
    }
    match /moderationLog/{id} {
      allow read: if isStaff();
    }

    // Reports: users report a listing once; the Cloud Function reports
    // ticket files that were uploaded before. The team handles them.
    match /reports/{id} {
      allow read: if isStaff() || isUser(resource.data.reporterId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type', 'listingId', 'reason', 'text',
            'reporterId', 'status', 'createdAt'])
        && request.resource.data.type == 'listing'
        && id == request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason in ['fake', 'price', 'wrongEvent', 'spam', 'other']
        && optStr(request.resource.data, 'text', 500)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && exists(listingPath(request.resource.data.listingId))
        && get(listingPath(request.resource.data.listingId)).data.sellerId != request.auth.uid;
      allow update: if isStaff()
        && onlyChanges(['status', 'handledBy', 'handledAt', 'note'])
        && request.resource.data.status in ['open', 'resolved', 'dismissed']
        && request.resource.data.handledBy == request.auth.uid
        && request.resource.data.handledAt == request.time
        && optStr(request.resource.data, 'note', 500);
    }

    // The platform's invoices for its service fee (Cloud Function).
    match /invoices/{id} {
      allow read: if isUser(resource.data.recipientUid) || isAdmin();
    }

    // Users add events unconfirmed ("pending"); the team (admins and
    // support accounts) checks, corrects, confirms or hides them. Tickets can
    // be listed for pending and confirmed events.
    match /events/{id} {
      function validEventDoc(d) {
        return d.keys().hasOnly(['name', 'venue', 'city', 'date', 'category',
            'genre', 'status', 'createdBy', 'hasImage', 'imageVersion',
            'postponedFrom', 'cancelReason', 'maxMarkupPercent', 'createdAt', 'updatedAt'])
          && validMarkup(d.get('maxMarkupPercent', null))
          && str(d.name, 2, 100)
          && str(d.venue, 1, 100)
          && str(d.city, 1, 60)
          && d.date is timestamp
          && d.category in ['concerts', 'sports', 'theater', 'festivals', 'other']
          && optStr(d, 'genre', 40)
          && d.status in ['pending', 'confirmed', 'hidden', 'active', 'cancelled']
          && d.hasImage is bool
          && d.imageVersion is int
          && d.updatedAt == request.time;
      }
      allow read: if resource.data.status in ['pending', 'confirmed', 'active', 'cancelled']
        || isStaff();
      allow create: if signedIn()
        && validEventDoc(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.date > request.time
        && request.resource.data.date < request.time + duration.value(730, 'd')
        && request.resource.data.imageVersion == 1
        && !('postponedFrom' in request.resource.data)
        && (
          // The team adds confirmed events.
          (isStaff() && request.resource.data.status == 'confirmed')
          // Users with a confirmed email add them for the team to check.
          || (verifiedEmail() && !banned() && request.resource.data.status == 'pending'
            && !('maxMarkupPercent' in request.resource.data))
        );
      allow update: if isStaff() && validEventDoc(request.resource.data)
        // Cancelling refunds everybody: only the Cloud Function does it.
        && (request.resource.data.status != 'cancelled' || resource.data.status == 'cancelled')
        && request.resource.data.get('postponedFrom', null) == resource.data.get('postponedFrom', null)
        && request.resource.data.createdAt == resource.data.createdAt
        // An event's own resale limit is the admins' decision.
        && (isAdmin() || request.resource.data.get('maxMarkupPercent', null)
          == resource.data.get('maxMarkupPercent', null))
        && request.resource.data.get('createdBy', null)
          == resource.data.get('createdBy', null);
      allow delete: if false;
    }

    // An event's picture: a JPEG in base64, kept apart so event lists stay
    // small. Users add one only together with their new event.
    match /eventImages/{id} {
      function validImage() {
        return request.resource.data.keys().hasOnly(['data', 'updatedAt'])
          && str(request.resource.data.data, 100, 400000)
          && request.resource.data.updatedAt == request.time;
      }
      function newOwnEvent() {
        return !exists(/databases/$(database)/documents/events/$(id))
          && getAfter(/databases/$(database)/documents/events/$(id)).data.createdBy
            == request.auth.uid
          && getAfter(/databases/$(database)/documents/events/$(id)).data.hasImage == true;
      }
      allow read: if true;
      allow create: if signedIn() && validImage() && (isStaff() || newOwnEvent());
      allow update: if isStaff() && validImage();
      allow delete: if isStaff();
    }

    // ---- Support (in the app, no email) -----------------------------------

    match /supportTickets/{id} {
      function ticketKeys() {
        return ['number', 'uid', 'email', 'name', 'topic', 'reference', 'subject',
          'status', 'unreadForUser', 'unreadForStaff', 'closedBy', 'appVersion',
          'createdAt', 'lastMessageAt'];
      }
      allow read: if isStaff() || isUser(resource.data.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(ticketKeys())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && optStr(request.resource.data, 'name', 80)
        && request.resource.data.number.matches('^SUP-[A-Z0-9]{6}$')
        && request.resource.data.topic in ['order', 'sale', 'payout', 'account', 'other']
        && str(request.resource.data.reference, 0, 60)
        && str(request.resource.data.subject, 1, 100)
        && optStr(request.resource.data, 'appVersion', 60)
        && request.resource.data.status == 'open'
        && request.resource.data.unreadForUser == false
        && request.resource.data.unreadForStaff == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time;

      allow update: if
        // The user: read an answer, write again (reopens it for the team) or
        // close it when satisfied. Closed requests stay closed.
        (isUser(resource.data.uid)
          && resource.data.status != 'closed'
          && (
            (onlyChanges(['unreadForUser'])
              && request.resource.data.unreadForUser == false)
            || (onlyChanges(['status', 'unreadForUser', 'unreadForStaff', 'lastMessageAt'])
              && request.resource.data.status == 'open'
              && request.resource.data.unreadForUser == false
              && request.resource.data.unreadForStaff == true
              && request.resource.data.lastMessageAt == request.time)
            || (onlyChanges(['status', 'closedBy', 'unreadForUser', 'unreadForStaff'])
              && request.resource.data.status == 'closed'
              && request.resource.data.closedBy == 'user'
              && request.resource.data.unreadForStaff == false)
          ))
        // The user opens a request the team closed.
        || (isUser(resource.data.uid)
          && resource.data.status == 'closed'
          && onlyChanges(['unreadForUser'])
          && request.resource.data.unreadForUser == false)
        // The team: read, answer, close.
        || (isStaff()
          && onlyChanges(['status', 'closedBy', 'unreadForUser', 'unreadForStaff', 'lastMessageAt'])
          && request.resource.data.status in ['open', 'answered', 'closed']
          && request.resource.data.unreadForUser is bool
          && request.resource.data.unreadForStaff is bool
          && (!('closedBy' in request.resource.data)
            || request.resource.data.closedBy in ['user', 'staff'])
          && (request.resource.data.lastMessageAt == resource.data.lastMessageAt
            || request.resource.data.lastMessageAt == request.time));

      allow delete: if false;

      match /messages/{mid} {
        function ticket() {
          return get(/databases/$(database)/documents/supportTickets/$(id)).data;
        }
        // Up to 3 pictures, each a JPEG in base64 under ~220 KB.
        function validImages(d) {
          return d.images is list && d.images.size() <= 3
            && (d.images.size() < 1 || str(d.images[0], 100, 300000))
            && (d.images.size() < 2 || str(d.images[1], 100, 300000))
            && (d.images.size() < 3 || str(d.images[2], 100, 300000));
        }
        allow read: if isStaff()
          || isUser(get(/databases/$(database)/documents/supportTickets/$(id)).data.uid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorId', 'authorRole',
              'authorName', 'text', 'images', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && optStr(request.resource.data, 'authorName', 80)
          && str(request.resource.data.text, 0, 2000)
          && validImages(request.resource.data)
          && (request.resource.data.text.size() > 0
            || request.resource.data.images.size() > 0)
          && request.resource.data.createdAt == request.time
          && (
            // The user, in their own open request (or the one being opened).
            (request.resource.data.authorRole == 'user'
              && getAfter(/databases/$(database)/documents/supportTickets/$(id)).data.uid
                == request.auth.uid
              && getAfter(/databases/$(database)/documents/supportTickets/$(id)).data.status
                == 'open')
            // The team, while the request is not closed.
            || (request.resource.data.authorRole == 'staff'
              && isStaff()
              && ticket().status != 'closed')
          );
        allow update, delete: if false;
      }
    }
  }
}
